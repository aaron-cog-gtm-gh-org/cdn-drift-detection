{
  "configId": "waf_90010",
  "configName": "www.rbcdemo.ca security config",
  "configVersion": 17,
  "productionStatus": "ACTIVATED",
  "securityPolicies": [
    {
      "id": "pol_www_1",
      "name": "Default policy",
      "hostnames": [
        "www.rbcdemo.ca"
      ],
      "defaultProfile": "web_default_v2"
    },
    {
      "id": "pol_www_2",
      "name": "API policy",
      "hostnames": [
        "www.rbcdemo.ca"
      ],
      "defaultProfile": "api_default_v1"
    }
  ],
  "matchTargets": {
    "items": [
      {
        "targetId": "tgt_pol_www",
        "type": "website",
        "hostnames": [
          "www.rbcdemo.ca"
        ],
        "bypassNetworkLists": [
          {
            "id": "nl_corp_allowlist"
          }
        ],
        "defaultFile": "NOFILE",
        "filePaths": [
          "/*"
        ]
      }
    ]
  },
  "wafRules": {
    "managedRuleset": {
      "id": "akamai_managed_30001",
      "version": "auto-update",
      "attackGroups": [
        {
          "group": "SQL",
          "action": "deny"
        },
        {
          "group": "XSS",
          "action": "deny"
        },
        {
          "group": "CMD",
          "action": "deny"
        },
        {
          "group": "LFI",
          "action": "alert"
        },
        {
          "group": "RFI",
          "action": "alert"
        },
        {
          "group": "PROTO",
          "action": "alert"
        },
        {
          "group": "POLICY",
          "action": "alert"
        }
      ]
    },
    "customRules": [
      {
        "id": "cr_1001",
        "name": "Block direct IP access",
        "conditions": [
          {
            "type": "hostname",
            "operator": "DOES_NOT_MATCH",
            "value": "www.rbcdemo.ca"
          }
        ],
        "action": "deny"
      },
      {
        "id": "cr_1002",
        "name": "Allow health checks",
        "conditions": [
          {
            "type": "path",
            "operator": "MATCHES",
            "value": "/health"
          }
        ],
        "action": "alert"
      }
    ]
  },
  "ratePolicies": {
    "items": [
      {
        "id": "rp_9001",
        "name": "Global API rate",
        "averageThreshold": 500,
        "burstThreshold": 100,
        "period": 60,
        "action": "deny",
        "matchType": "ALL_REQUESTS"
      }
    ]
  },
  "slowPostProtection": {
    "enabled": true,
    "slowRate": "10bps",
    "action": "alert"
  },
  "reputationProfiles": {
    "items": [
      {
        "id": "rep_1",
        "name": "Web attackers",
        "threshold": 5,
        "action": "deny",
        "context": "WEBATCK"
      },
      {
        "id": "rep_2",
        "name": "Scrapers",
        "threshold": 7,
        "action": "alert",
        "context": "SCRP"
      }
    ]
  },
  "networkLists": {
    "items": [
      {
        "id": "nl_corp_allowlist",
        "name": "Corporate allowlist",
        "type": "IP",
        "list": [
          "198.51.100.0/24",
          "203.0.113.55"
        ]
      },
      {
        "id": "nl_geo_block",
        "name": "Geo blocklist",
        "type": "GEO",
        "list": [
          "KP",
          "IR",
          "CU",
          "SY"
        ]
      }
    ]
  },
  "botManagement": {
    "enabled": true,
    "product": "BOT_MANAGEMENT_PREMIER",
    "botEndpointCoverage": [
      "/signin",
      "/auth/*",
      "/promo/*"
    ]
  }
}
