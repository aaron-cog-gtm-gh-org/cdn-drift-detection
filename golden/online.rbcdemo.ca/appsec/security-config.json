{
  "configId": "waf_90011",
  "configName": "online.rbcdemo.ca security config",
  "configVersion": 23,
  "productionStatus": "ACTIVATED",
  "securityPolicies": [
    {
      "id": "pol_online_1",
      "name": "Default policy",
      "hostnames": [
        "online.rbcdemo.ca"
      ],
      "defaultProfile": "web_default_v2"
    }
  ],
  "matchTargets": {
    "items": [
      {
        "targetId": "tgt_pol_online",
        "type": "website",
        "hostnames": [
          "online.rbcdemo.ca"
        ],
        "bypassNetworkLists": [
          {
            "id": "nl_corp_allowlist"
          }
        ],
        "defaultFile": "NOFILE",
        "filePaths": [
          "/*"
        ]
      }
    ]
  },
  "wafRules": {
    "managedRuleset": {
      "id": "akamai_managed_30001",
      "version": "auto-update",
      "attackGroups": [
        {
          "group": "SQL",
          "action": "deny"
        },
        {
          "group": "XSS",
          "action": "deny"
        },
        {
          "group": "CMD",
          "action": "deny"
        },
        {
          "group": "LFI",
          "action": "alert"
        },
        {
          "group": "RFI",
          "action": "alert"
        },
        {
          "group": "PROTO",
          "action": "deny"
        },
        {
          "group": "POLICY",
          "action": "alert"
        }
      ]
    },
    "customRules": [
      {
        "id": "cr_1001",
        "name": "Block direct IP access",
        "conditions": [
          {
            "type": "hostname",
            "operator": "DOES_NOT_MATCH",
            "value": "online.rbcdemo.ca"
          }
        ],
        "action": "deny"
      },
      {
        "id": "cr_1002",
        "name": "Allow health checks",
        "conditions": [
          {
            "type": "path",
            "operator": "MATCHES",
            "value": "/health"
          }
        ],
        "action": "alert"
      }
    ]
  },
  "ratePolicies": {
    "items": [
      {
        "id": "rp_9001",
        "name": "Global API rate",
        "averageThreshold": 500,
        "burstThreshold": 100,
        "period": 60,
        "action": "deny",
        "matchType": "ALL_REQUESTS"
      },
      {
        "id": "rp_9002",
        "name": "Login rate policy",
        "averageThreshold": 30,
        "burstThreshold": 5,
        "period": 60,
        "action": "deny",
        "matchType": "PATH",
        "pathMatch": [
          "/auth/login"
        ]
      }
    ]
  },
  "slowPostProtection": {
    "enabled": true,
    "slowRate": "10bps",
    "action": "deny"
  },
  "reputationProfiles": {
    "items": [
      {
        "id": "rep_1",
        "name": "Web attackers",
        "threshold": 5,
        "action": "deny",
        "context": "WEBATCK"
      },
      {
        "id": "rep_2",
        "name": "Scrapers",
        "threshold": 7,
        "action": "alert",
        "context": "SCRP"
      }
    ]
  },
  "networkLists": {
    "items": [
      {
        "id": "nl_corp_allowlist",
        "name": "Corporate allowlist",
        "type": "IP",
        "list": [
          "198.51.100.0/24",
          "203.0.113.55"
        ]
      },
      {
        "id": "nl_geo_block",
        "name": "Geo blocklist",
        "type": "GEO",
        "list": [
          "KP",
          "IR",
          "CU",
          "SY"
        ]
      }
    ]
  }
}
