{
  "rules": {
    "name": "default",
    "children": [
      {
        "name": "CORS preflight",
        "children": [],
        "behaviors": [
          {
            "name": "constructResponse",
            "options": {
              "enabled": true,
              "responseCode": 204,
              "body": "",
              "contentType": "text/plain"
            }
          },
          {
            "name": "modifyOutgoingResponseHeader",
            "options": {
              "action": "ADD",
              "customHeaderName": "Access-Control-Allow-Origin",
              "customHeaderValue": "https://online.rbcdemo.ca, https://www.rbcdemo.ca",
              "standardModifyHeaderName": "OTHER"
            }
          },
          {
            "name": "modifyOutgoingResponseHeader",
            "options": {
              "action": "ADD",
              "customHeaderName": "Access-Control-Allow-Credentials",
              "customHeaderValue": "true",
              "standardModifyHeaderName": "OTHER"
            }
          }
        ],
        "criteria": [
          {
            "name": "requestMethod",
            "options": {
              "matchOperator": "IS_ONE_OF",
              "values": [
                "OPTIONS"
              ]
            }
          }
        ],
        "criteriaMustSatisfy": "all",
        "comment": "Preflight answered at edge; origins list mirrors CF response transform."
      },
      {
        "name": "API authorization",
        "children": [],
        "behaviors": [
          {
            "name": "centralAuthorization",
            "options": {
              "enabled": true,
              "authServerHostname": "idp.rbcdemo.ca"
            }
          }
        ],
        "criteria": [
          {
            "name": "path",
            "options": {
              "matchOperator": "MATCHES_ONE_OF",
              "values": [
                "/v2/*"
              ],
              "matchCaseSensitive": false
            }
          }
        ],
        "criteriaMustSatisfy": "all",
        "comment": "Delegated edge authorization via Central Authorization service (JWKS at IdP)."
      },
      {
        "name": "Partner request tagging",
        "children": [],
        "behaviors": [
          {
            "name": "modifyIncomingRequestHeader",
            "options": {
              "action": "ADD",
              "customHeaderName": "X-RBCDemo-Partner",
              "customHeaderValue": "ob",
              "standardModifyHeaderName": "OTHER",
              "standardAddHeaderName": "OTHER"
            }
          },
          {
            "name": "caching",
            "options": {
              "behavior": "BYPASS",
              "mustRevalidate": false,
              "ttl": "0s",
              "enhancedRfc": false
            }
          }
        ],
        "criteria": [
          {
            "name": "path",
            "options": {
              "matchOperator": "MATCHES_ONE_OF",
              "values": [
                "/open-banking/*"
              ],
              "matchCaseSensitive": false
            }
          }
        ],
        "criteriaMustSatisfy": "all",
        "comment": "Partner rate policies enforced in App Sec (rate policy 9101), not the property."
      },
      {
        "name": "JSON compression",
        "children": [],
        "behaviors": [
          {
            "name": "gzipResponse",
            "options": {
              "behavior": "ALWAYS"
            }
          }
        ],
        "criteria": [
          {
            "name": "requestHeader",
            "options": {
              "headerName": "content-type",
              "matchOperator": "MATCHES_ONE_OF",
              "values": [
                "application/json*"
              ],
              "matchCaseSensitive": false
            }
          }
        ],
        "criteriaMustSatisfy": "all",
        "comment": ""
      },
      {
        "name": "Version pinning",
        "children": [],
        "behaviors": [
          {
            "name": "cacheKeyQueryParams",
            "options": {
              "behavior": "IGNORE",
              "exactMatch": true,
              "parameters": []
            }
          }
        ],
        "criteria": [
          {
            "name": "requestHeader",
            "options": {
              "headerName": "accept-version",
              "matchOperator": "IS_DEFINED"
            }
          }
        ],
        "criteriaMustSatisfy": "all",
        "comment": ""
      },
      {
        "name": "Token endpoint",
        "children": [],
        "behaviors": [
          {
            "name": "caching",
            "options": {
              "behavior": "NO_STORE",
              "mustRevalidate": false,
              "ttl": "0s",
              "enhancedRfc": false
            }
          },
          {
            "name": "allowPost",
            "options": {
              "allowWithoutContentLength": false,
              "enabled": true
            }
          }
        ],
        "criteria": [
          {
            "name": "path",
            "options": {
              "matchOperator": "MATCHES_ONE_OF",
              "values": [
                "/oauth/token"
              ],
              "matchCaseSensitive": false
            }
          }
        ],
        "criteriaMustSatisfy": "all",
        "comment": ""
      },
      {
        "name": "Billing APIs",
        "children": [],
        "behaviors": [
          {
            "name": "caching",
            "options": {
              "behavior": "BYPASS",
              "mustRevalidate": false,
              "ttl": "0s",
              "enhancedRfc": false
            }
          }
        ],
        "criteria": [
          {
            "name": "path",
            "options": {
              "matchOperator": "MATCHES_ONE_OF",
              "values": [
                "/v2/billing/*"
              ],
              "matchCaseSensitive": false
            }
          }
        ],
        "criteriaMustSatisfy": "all",
        "comment": "Billing payloads are personalized; bypass cache. Rate limit via App Sec."
      },
      {
        "name": "Health checks",
        "children": [],
        "behaviors": [
          {
            "name": "constructResponse",
            "options": {
              "enabled": true,
              "responseCode": 200,
              "body": "ok",
              "contentType": "text/plain"
            }
          }
        ],
        "criteria": [
          {
            "name": "path",
            "options": {
              "matchOperator": "MATCHES_ONE_OF",
              "values": [
                "/health",
                "/readyz"
              ],
              "matchCaseSensitive": false
            }
          }
        ],
        "criteriaMustSatisfy": "all",
        "comment": "Synthetic health response at edge; keeps LB probes off origin."
      },
      {
        "name": "Legacy v1 sunset",
        "children": [],
        "behaviors": [
          {
            "name": "simulateErrorCode",
            "options": {
              "enabled": true,
              "responseCode": 410,
              "responseBody": "API v1 retired 2026-06-30; migrate to /v2"
            }
          }
        ],
        "criteria": [
          {
            "name": "path",
            "options": {
              "matchOperator": "MATCHES_ONE_OF",
              "values": [
                "/v1/*"
              ],
              "matchCaseSensitive": false
            }
          }
        ],
        "criteriaMustSatisfy": "all",
        "comment": "Sunset window \u2014 remove rule after EDG-2400 closes."
      }
    ],
    "behaviors": [
      {
        "name": "origin",
        "options": {
          "cacheKeyHostname": "ORIGIN_HOSTNAME",
          "compress": true,
          "enableTrueClientIp": true,
          "forwardHostHeader": "REQUEST_HOST_HEADER",
          "hostname": "origin-api.rbcdemo.ca",
          "httpPort": 80,
          "httpsPort": 443,
          "ipVersion": "IPV4",
          "minTlsVersion": "TLSV1_2",
          "originCertificate": "",
          "originSni": true,
          "originType": "CUSTOMER",
          "ports": "443",
          "tlsVersionTitle": "",
          "trueClientIpClientSetting": false,
          "trueClientIpHeader": "True-Client-IP",
          "verificationMode": "CUSTOM",
          "customValidCnValues": [
            "{{Origin Hostname}}",
            "{{Forward Host Header}}"
          ],
          "originCertsToHonor": "STANDARD_CERTIFICATE_AUTHORITIES",
          "standardCertificateAuthorities": [
            "akamai-perimeter"
          ]
        }
      },
      {
        "name": "cpCode",
        "options": {
          "id": 92603,
          "name": "api.rbcdemo.ca-cpcode"
        }
      },
      {
        "name": "caching",
        "options": {
          "behavior": "MAX_AGE",
          "mustRevalidate": false,
          "ttl": "4h",
          "enhancedRfc": false,
          "honorBrowserTtl": false,
          "sendTrueClientIpHeader": false
        }
      },
      {
        "name": "sureRoute",
        "options": {
          "enabled": true,
          "srStatisticalMethod": "ALPHA",
          "testObjectUrl": "/akamai/sureroute-test-object.html",
          "toAlternate": false,
          "alternateHostname": ""
        }
      },
      {
        "name": "tieredDistribution",
        "options": {
          "enabled": false,
          "tieredDistributionMap": "CH2"
        }
      },
      {
        "name": "prefetch",
        "options": {
          "enabled": false
        }
      },
      {
        "name": "allowPost",
        "options": {
          "allowWithoutContentLength": false,
          "enabled": true
        }
      },
      {
        "name": "http2",
        "options": {
          "enabled": true
        }
      },
      {
        "name": "http3",
        "options": {
          "enabled": true
        }
      },
      {
        "name": "gzipResponse",
        "options": {
          "behavior": "ALWAYS"
        }
      },
      {
        "name": "report",
        "options": {
          "logHost": false,
          "logReferer": true,
          "logUserAgent": true,
          "logAcceptLanguage": false,
          "logCookies": "OFF",
          "logCustomLogField": false
        }
      },
      {
        "name": "mPulse",
        "options": {
          "enabled": false,
          "apiKey": "",
          "bufferSize": "",
          "requirePci": false,
          "titleOverride": ""
        }
      },
      {
        "name": "webApplicationFirewall",
        "options": {
          "enable": true
        }
      },
      {
        "name": "adaptiveAcceleration",
        "options": {
          "enablePreconnect": true,
          "enablePreload": false,
          "enablePush": false,
          "enableRo": true,
          "enableBrotliCompression": true,
          "enableDnsPrefetch": true,
          "enableForNoncacheable": false,
          "mPulseBpulseLoaderSnippetVersion": "v12",
          "source": "mPulse"
        }
      },
      {
        "name": "enhancedAkamaiProtocol",
        "options": {
          "display": "OFF",
          "enabled": false
        }
      },
      {
        "name": "removeVary",
        "options": {
          "enabled": true
        }
      },
      {
        "name": "modifyOutgoingResponseHeader",
        "options": {
          "action": "ADD",
          "customHeaderName": "Strict-Transport-Security",
          "customHeaderValue": "max-age=31536000; includeSubDomains",
          "standardModifyHeaderName": "OTHER"
        }
      },
      {
        "name": "cacheKeyQueryParams",
        "options": {
          "behavior": "IGNORE",
          "exactMatch": true,
          "parameters": []
        }
      },
      {
        "name": "datastream",
        "options": {
          "enabled": true,
          "logStreamName": "rbcdemo-edge-logs",
          "streamType": "COMPLETE_LOGS"
        }
      }
    ],
    "options": {
      "is_secure": true
    },
    "variables": [
      {
        "name": "PMUSER_PARTNER_TIER",
        "value": "STANDARD",
        "description": "Partner tier for rate policy",
        "hidden": false,
        "sensitive": false
      }
    ]
  }
}
