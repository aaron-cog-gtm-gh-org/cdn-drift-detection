{
  "configId": 90012,
  "configName": "api.rbcdemo.ca security config",
  "configVersion": 9,
  "productionStatus": "ACTIVATED",
  "securityPolicies": [
    {
      "id": "pol_api_1",
      "name": "API policy",
      "hostnames": [
        "api.rbcdemo.ca"
      ],
      "defaultProfile": "api_default_v1"
    }
  ],
  "matchTargets": {
    "items": [
      {
        "targetId": "tgt_pol_api",
        "type": "website",
        "hostnames": [
          "api.rbcdemo.ca"
        ],
        "bypassNetworkLists": [
          {
            "id": "nl_corp_allowlist"
          }
        ],
        "defaultFile": "NOFILE",
        "filePaths": [
          "/*"
        ]
      }
    ]
  },
  "wafRules": {
    "managedRuleset": {
      "id": "akamai_managed_30001",
      "version": "auto-update",
      "attackGroups": [
        {
          "group": "SQL",
          "action": "deny"
        },
        {
          "group": "XSS",
          "action": "deny"
        },
        {
          "group": "CMD",
          "action": "deny"
        },
        {
          "group": "LFI",
          "action": "alert"
        },
        {
          "group": "RFI",
          "action": "alert"
        },
        {
          "group": "PROTO",
          "action": "alert"
        },
        {
          "group": "POLICY",
          "action": "alert"
        }
      ]
    },
    "customRules": [
      {
        "id": "cr_1001",
        "name": "Block direct IP access",
        "conditions": [
          {
            "type": "hostname",
            "operator": "DOES_NOT_MATCH",
            "value": "api.rbcdemo.ca"
          }
        ],
        "action": "deny"
      },
      {
        "id": "cr_1002",
        "name": "Allow health checks",
        "conditions": [
          {
            "type": "path",
            "operator": "MATCHES",
            "value": "/health"
          }
        ],
        "action": "alert"
      }
    ]
  },
  "ratePolicies": {
    "items": [
      {
        "id": 9001,
        "name": "Global API rate",
        "averageThreshold": 500,
        "burstThreshold": 100,
        "period": 60,
        "action": "deny",
        "matchType": "ALL_REQUESTS"
      },
      {
        "id": 9101,
        "name": "Open-banking partner rate",
        "averageThreshold": 100,
        "burstThreshold": 50,
        "period": 60,
        "action": "deny",
        "matchType": "PATH",
        "pathMatch": [
          "/open-banking/*"
        ]
      },
      {
        "id": 9102,
        "name": "Mobile app rate",
        "averageThreshold": 600,
        "burstThreshold": 100,
        "period": 60,
        "action": "alert",
        "matchType": "REQUEST_HEADER",
        "headerMatch": {
          "name": "x-rbcdemo-app",
          "present": true
        }
      }
    ]
  },
  "slowPostProtection": {
    "enabled": true,
    "slowRate": "10bps",
    "action": "alert"
  },
  "reputationProfiles": {
    "items": [
      {
        "id": "rep_1",
        "name": "Web attackers",
        "threshold": 5,
        "action": "deny",
        "context": "WEBATCK"
      },
      {
        "id": "rep_2",
        "name": "Scrapers",
        "threshold": 7,
        "action": "alert",
        "context": "SCRP"
      }
    ]
  },
  "networkLists": {
    "items": [
      {
        "id": "nl_corp_allowlist",
        "name": "Corporate allowlist",
        "type": "IP",
        "list": [
          "198.51.100.0/24",
          "203.0.113.55"
        ]
      },
      {
        "id": "nl_geo_block",
        "name": "Geo blocklist",
        "type": "GEO",
        "list": [
          "KP",
          "IR",
          "CU",
          "SY"
        ]
      }
    ]
  },
  "apiConstraints": {
    "enabled": true,
    "action": "BLOCK",
    "schemaEndpoints": [
      {
        "path": "/v2/payees*",
        "schemaId": "sch_payees_v3"
      }
    ]
  }
}
