{
  "rules": {
    "name": "default",
    "children": [
      {
        "name": "Downloads token auth",
        "children": [],
        "behaviors": [
          {
            "name": "tokenAuthorization",
            "options": {
              "enabled": true,
              "hmacKey": "TRANSIENT",
              "hmacAlgorithm": "SHA256",
              "tokenName": "__token",
              "salt": "",
              "escapeEarly": true,
              "stripToken": true
            }
          }
        ],
        "criteria": [
          {
            "name": "path",
            "options": {
              "matchOperator": "MATCHES_ONE_OF",
              "values": [
                "/downloads/*",
                "/secure/*"
              ],
              "matchCaseSensitive": false
            }
          }
        ],
        "criteriaMustSatisfy": "all",
        "comment": "Token auth required on /downloads/* and /secure/*."
      },
      {
        "name": "Long-TTL media",
        "children": [],
        "behaviors": [
          {
            "name": "caching",
            "options": {
              "behavior": "MAX_AGE",
              "ttl": "30d",
              "mustRevalidate": true,
              "enhancedRfc": false
            }
          }
        ],
        "criteria": [
          {
            "name": "fileExtension",
            "options": {
              "matchOperator": "IS_ONE_OF",
              "values": [
                "mp4",
                "mp3",
                "pdf",
                "zip"
              ],
              "matchCaseSensitive": false
            }
          }
        ],
        "criteriaMustSatisfy": "all",
        "comment": ""
      },
      {
        "name": "CORS for webfonts",
        "children": [],
        "behaviors": [
          {
            "name": "modifyOutgoingResponseHeader",
            "options": {
              "action": "ADD",
              "customHeaderName": "Access-Control-Allow-Origin",
              "customHeaderValue": "*",
              "standardModifyHeaderName": "OTHER"
            }
          }
        ],
        "criteria": [
          {
            "name": "fileExtension",
            "options": {
              "matchOperator": "IS_ONE_OF",
              "values": [
                "woff",
                "woff2",
                "ttf"
              ],
              "matchCaseSensitive": false
            }
          }
        ],
        "criteriaMustSatisfy": "all",
        "comment": ""
      },
      {
        "name": "Versioned assets",
        "children": [],
        "behaviors": [
          {
            "name": "caching",
            "options": {
              "behavior": "MAX_AGE",
              "ttl": "365d",
              "mustRevalidate": true,
              "enhancedRfc": false
            }
          }
        ],
        "criteria": [
          {
            "name": "path",
            "options": {
              "matchOperator": "MATCHES_WILDCARD",
              "values": [
                "/v*/assets/*"
              ],
              "matchCaseSensitive": false
            }
          }
        ],
        "criteriaMustSatisfy": "all",
        "comment": "Fingerprinted \u2014 immutable."
      },
      {
        "name": "Query-param cache key",
        "children": [],
        "behaviors": [
          {
            "name": "cacheKeyQueryParams",
            "options": {
              "behavior": "INCLUDE",
              "exactMatch": true,
              "parameters": [
                "v",
                "lang"
              ]
            }
          }
        ],
        "criteria": [
          {
            "name": "queryStringParameter",
            "options": {
              "parameterName": "v",
              "matchOperator": "IS_NOT_EMPTY"
            }
          }
        ],
        "criteriaMustSatisfy": "all",
        "comment": ""
      },
      {
        "name": "Image variants",
        "children": [
          {
            "name": "WebP negotiation",
            "children": [],
            "behaviors": [
              {
                "name": "setVariable",
                "options": {
                  "variableName": "PMUSER_FMT",
                  "valueSource": "EXPRESSION",
                  "variableValue": "webp",
                  "transform": "NONE"
                }
              }
            ],
            "criteria": [
              {
                "name": "requestHeader",
                "options": {
                  "headerName": "accept",
                  "matchOperator": "MATCHES_WILDCARD",
                  "values": [
                    "*image/webp*"
                  ],
                  "matchCaseSensitive": false
                }
              }
            ],
            "criteriaMustSatisfy": "all",
            "comment": ""
          }
        ],
        "behaviors": [
          {
            "name": "imageAndVideoManager",
            "options": {
              "enabled": true,
              "policyTokenDefault": "rbcdemo-assets-im"
            }
          }
        ],
        "criteria": [
          {
            "name": "fileExtension",
            "options": {
              "matchOperator": "IS_ONE_OF",
              "values": [
                "jpg",
                "jpeg",
                "png",
                "webp"
              ],
              "matchCaseSensitive": false
            }
          }
        ],
        "criteriaMustSatisfy": "all",
        "comment": ""
      },
      {
        "name": "Prefetch hints",
        "children": [],
        "behaviors": [
          {
            "name": "prefetch",
            "options": {
              "enabled": true
            }
          }
        ],
        "criteria": [
          {
            "name": "path",
            "options": {
              "matchOperator": "MATCHES_ONE_OF",
              "values": [
                "/css/*",
                "/js/*"
              ],
              "matchCaseSensitive": false
            }
          }
        ],
        "criteriaMustSatisfy": "all",
        "comment": ""
      },
      {
        "name": "Country expiry rules",
        "children": [
          {
            "name": "Embargoed",
            "children": [],
            "behaviors": [
              {
                "name": "denyAccess",
                "options": {
                  "enabled": true,
                  "reason": "GEO"
                }
              }
            ],
            "criteria": [
              {
                "name": "userLocation",
                "options": {
                  "matchOperator": "IS_ONE_OF",
                  "values": [
                    "country:KP",
                    "country:IR"
                  ],
                  "matchCaseSensitive": false
                }
              }
            ],
            "criteriaMustSatisfy": "all",
            "comment": ""
          }
        ],
        "behaviors": [],
        "criteria": [],
        "criteriaMustSatisfy": "all",
        "comment": ""
      }
    ],
    "behaviors": [
      {
        "name": "origin",
        "options": {
          "cacheKeyHostname": "ORIGIN_HOSTNAME",
          "compress": true,
          "enableTrueClientIp": true,
          "forwardHostHeader": "REQUEST_HOST_HEADER",
          "hostname": "origin-assets.rbcdemo.ca",
          "httpPort": 80,
          "httpsPort": 443,
          "ipVersion": "IPV4",
          "minTlsVersion": "DYNAMIC",
          "originCertificate": "",
          "originSni": true,
          "originType": "CUSTOMER",
          "ports": "443",
          "tlsVersionTitle": "",
          "trueClientIpClientSetting": false,
          "trueClientIpHeader": "True-Client-IP",
          "verificationMode": "CUSTOM",
          "customValidCnValues": [
            "{{Origin Hostname}}",
            "{{Forward Host Header}}"
          ],
          "originCertsToHonor": "STANDARD_CERTIFICATE_AUTHORITIES",
          "standardCertificateAuthorities": [
            "akamai-perimeter"
          ]
        }
      },
      {
        "name": "cpCode",
        "options": {
          "id": 92604,
          "name": "assets.rbcdemo.ca-cpcode"
        }
      },
      {
        "name": "caching",
        "options": {
          "behavior": "MAX_AGE",
          "mustRevalidate": false,
          "ttl": "4h",
          "enhancedRfc": false,
          "honorBrowserTtl": false,
          "sendTrueClientIpHeader": false
        }
      },
      {
        "name": "sureRoute",
        "options": {
          "enabled": false,
          "srStatisticalMethod": "ALPHA",
          "testObjectUrl": "/akamai/sureroute-test-object.html",
          "toAlternate": false,
          "alternateHostname": ""
        }
      },
      {
        "name": "tieredDistribution",
        "options": {
          "enabled": true,
          "tieredDistributionMap": "CH2"
        }
      },
      {
        "name": "prefetch",
        "options": {
          "enabled": true
        }
      },
      {
        "name": "allowPost",
        "options": {
          "allowWithoutContentLength": false,
          "enabled": true
        }
      },
      {
        "name": "http2",
        "options": {
          "enabled": true
        }
      },
      {
        "name": "http3",
        "options": {
          "enabled": false
        }
      },
      {
        "name": "gzipResponse",
        "options": {
          "behavior": "ALWAYS"
        }
      },
      {
        "name": "report",
        "options": {
          "logHost": false,
          "logReferer": true,
          "logUserAgent": true,
          "logAcceptLanguage": false,
          "logCookies": "OFF",
          "logCustomLogField": false
        }
      },
      {
        "name": "mPulse",
        "options": {
          "enabled": false,
          "apiKey": "",
          "bufferSize": "",
          "requirePci": false,
          "titleOverride": ""
        }
      },
      {
        "name": "webApplicationFirewall",
        "options": {
          "enable": true
        }
      },
      {
        "name": "adaptiveAcceleration",
        "options": {
          "enablePreconnect": true,
          "enablePreload": false,
          "enablePush": false,
          "enableRo": true,
          "enableBrotliCompression": true,
          "enableDnsPrefetch": true,
          "enableForNoncacheable": false,
          "mPulseBpulseLoaderSnippetVersion": "v12",
          "source": "mPulse"
        }
      },
      {
        "name": "enhancedAkamaiProtocol",
        "options": {
          "display": "OFF",
          "enabled": true
        }
      },
      {
        "name": "removeVary",
        "options": {
          "enabled": false
        }
      },
      {
        "name": "modifyOutgoingResponseHeader",
        "options": {
          "action": "ADD",
          "customHeaderName": "Strict-Transport-Security",
          "customHeaderValue": "max-age=31536000; includeSubDomains",
          "standardModifyHeaderName": "OTHER"
        }
      },
      {
        "name": "cacheKeyQueryParams",
        "options": {
          "behavior": "INCLUDE",
          "exactMatch": true,
          "parameters": [
            "v",
            "lang"
          ]
        }
      },
      {
        "name": "datastream",
        "options": {
          "enabled": true,
          "logStreamName": "rbcdemo-edge-logs",
          "streamType": "CUSTOM_LOGS"
        }
      }
    ],
    "options": {
      "is_secure": false
    },
    "variables": [
      {
        "name": "PMUSER_FMT",
        "value": "",
        "description": "Negotiated image format",
        "hidden": false,
        "sensitive": false
      }
    ]
  }
}
