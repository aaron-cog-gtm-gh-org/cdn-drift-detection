{
  "accountId": "act_1-2ABCDE",
  "contractId": "ctr_C-0N7RAC7",
  "groupId": "grp_98765",
  "propertyId": "prp_512345",
  "propertyName": "www.rbcdemo.ca",
  "propertyVersion": 47,
  "etag": "a1b2c3d4e5f60718293a4b5c6d7e8f947",
  "ruleFormat": "v2023-01-05",
  "rules": {
    "name": "default",
    "children": [
      {
        "name": "Static assets",
        "children": [],
        "behaviors": [
          {
            "name": "caching",
            "options": {
              "behavior": "MAX_AGE",
              "ttl": "7d",
              "mustRevalidate": true,
              "enhancedRfc": false
            }
          },
          {
            "name": "prefetch",
            "options": {
              "enabled": true
            }
          }
        ],
        "criteria": [
          {
            "name": "path",
            "options": {
              "matchOperator": "MATCHES_ONE_OF",
              "values": [
                "/assets/*",
                "/static/*"
              ],
              "matchCaseSensitive": false
            }
          },
          {
            "name": "fileExtension",
            "options": {
              "matchOperator": "IS_ONE_OF",
              "values": [
                "css",
                "js",
                "woff",
                "woff2"
              ],
              "matchCaseSensitive": false
            }
          }
        ],
        "criteriaMustSatisfy": "any",
        "comment": "Static site chrome. TTL raised to 7d per CHG0041182."
      },
      {
        "name": "Images",
        "children": [
          {
            "name": "Legacy formats",
            "children": [],
            "behaviors": [
              {
                "name": "imageAndVideoManager",
                "options": {
                  "enabled": true,
                  "policyTokenDefault": "rbcdemo-www-im"
                }
              }
            ],
            "criteria": [
              {
                "name": "fileExtension",
                "options": {
                  "matchOperator": "IS_ONE_OF",
                  "values": [
                    "jpg",
                    "jpeg",
                    "png"
                  ],
                  "matchCaseSensitive": false
                }
              }
            ],
            "criteriaMustSatisfy": "all",
            "comment": ""
          }
        ],
        "behaviors": [
          {
            "name": "caching",
            "options": {
              "behavior": "MAX_AGE",
              "ttl": "30d",
              "mustRevalidate": false,
              "enhancedRfc": false
            }
          }
        ],
        "criteria": [
          {
            "name": "fileExtension",
            "options": {
              "matchOperator": "IS_ONE_OF",
              "values": [
                "jpg",
                "jpeg",
                "png",
                "webp",
                "svg",
                "ico",
                "avif"
              ],
              "matchCaseSensitive": false
            }
          }
        ],
        "criteriaMustSatisfy": "all",
        "comment": "Image Manager policy rbcdemo-www-im"
      },
      {
        "name": "Geo restrictions",
        "children": [
          {
            "name": "Sanctioned countries",
            "children": [],
            "behaviors": [
              {
                "name": "denyAccess",
                "options": {
                  "enabled": true,
                  "reason": "GEO_BLOCKED"
                }
              }
            ],
            "criteria": [
              {
                "name": "userLocation",
                "options": {
                  "matchOperator": "IS_ONE_OF",
                  "values": [
                    "country:KP",
                    "country:IR",
                    "country:CU",
                    "country:SY"
                  ],
                  "matchCaseSensitive": false
                }
              }
            ],
            "criteriaMustSatisfy": "all",
            "comment": "OFAC/OSFI sanctions list. Do NOT remove \u2014 compliance req."
          }
        ],
        "behaviors": [],
        "criteria": [
          {
            "name": "userLocation",
            "options": {
              "matchOperator": "IS_NOT_ONE_OF",
              "values": [
                "continent:NA",
                "continent:EU"
              ],
              "matchCaseSensitive": false
            }
          }
        ],
        "criteriaMustSatisfy": "all",
        "comment": "Non-NA/EU traffic gets extra screening via children."
      },
      {
        "name": "Maintenance window",
        "children": [],
        "behaviors": [
          {
            "name": "redirect",
            "options": {
              "destinationHostname": "SAME_AS_REQUEST",
              "destinationPath": "/maintenance.html",
              "mobileDefaultChoice": "DEFAULT",
              "queryString": "APPEND",
              "responseCode": 302
            }
          }
        ],
        "criteria": [
          {
            "name": "matchVariable",
            "options": {
              "matchVariableName": "PMUSER_MAINTENANCE",
              "matchOperator": "IS",
              "matchExpression": "ON"
            }
          }
        ],
        "criteriaMustSatisfy": "all",
        "comment": "Flip PMUSER_MAINTENANCE=ON in variables to engage."
      },
      {
        "name": "Bot management",
        "children": [
          {
            "name": "Bad bots",
            "children": [],
            "behaviors": [
              {
                "name": "denyAccess",
                "options": {
                  "enabled": true,
                  "reason": "BOT"
                }
              }
            ],
            "criteria": [
              {
                "name": "requestHeader",
                "options": {
                  "headerName": "user-agent",
                  "matchOperator": "MATCHES_WILDCARD",
                  "values": [
                    "*sqlmap*",
                    "*nikto*",
                    "*masscan*"
                  ],
                  "matchCaseSensitive": false
                }
              }
            ],
            "criteriaMustSatisfy": "all",
            "comment": "Cheap signature layer \u2014 real bot logic in Bot Manager."
          }
        ],
        "behaviors": [
          {
            "name": "botManagement",
            "options": {
              "enabled": true,
              "botCategory": "ALL"
            }
          }
        ],
        "criteria": [],
        "criteriaMustSatisfy": "all",
        "comment": ""
      },
      {
        "name": "Sign-in redirect",
        "children": [],
        "behaviors": [
          {
            "name": "redirect",
            "options": {
              "destinationHostname": "ALTERNATE",
              "destinationPath": "https://online.rbcdemo.ca/auth/login",
              "queryString": "APPEND",
              "responseCode": 302,
              "mobileDefaultChoice": "DEFAULT"
            }
          }
        ],
        "criteria": [
          {
            "name": "path",
            "options": {
              "matchOperator": "MATCHES_ONE_OF",
              "values": [
                "/signin",
                "/signin/*"
              ],
              "matchCaseSensitive": false
            }
          }
        ],
        "criteriaMustSatisfy": "all",
        "comment": ""
      },
      {
        "name": "Marketing campaigns",
        "children": [
          {
            "name": "QR landing",
            "children": [],
            "behaviors": [
              {
                "name": "cacheKeyQueryParams",
                "options": {
                  "behavior": "INCLUDE",
                  "exactMatch": true,
                  "parameters": [
                    "utm_campaign",
                    "v"
                  ]
                }
              }
            ],
            "criteria": [
              {
                "name": "queryStringParameter",
                "options": {
                  "parameterName": "utm_campaign",
                  "matchOperator": "IS_NOT_EMPTY"
                }
              }
            ],
            "criteriaMustSatisfy": "all",
            "comment": ""
          }
        ],
        "behaviors": [
          {
            "name": "caching",
            "options": {
              "behavior": "MAX_AGE",
              "ttl": "1h",
              "mustRevalidate": false,
              "enhancedRfc": false
            }
          }
        ],
        "criteria": [
          {
            "name": "path",
            "options": {
              "matchOperator": "MATCHES_ONE_OF",
              "values": [
                "/promo/*",
                "/campaigns/*"
              ],
              "matchCaseSensitive": false
            }
          }
        ],
        "criteriaMustSatisfy": "all",
        "comment": ""
      },
      {
        "name": "API passthrough",
        "children": [],
        "behaviors": [
          {
            "name": "caching",
            "options": {
              "behavior": "NO_STORE",
              "mustRevalidate": false,
              "ttl": "0s",
              "enhancedRfc": false
            }
          }
        ],
        "criteria": [
          {
            "name": "path",
            "options": {
              "matchOperator": "MATCHES_ONE_OF",
              "values": [
                "/api/*"
              ],
              "matchCaseSensitive": false
            }
          }
        ],
        "criteriaMustSatisfy": "all",
        "comment": "Was 5m cache \u2014 removed after incident INC0091234."
      },
      {
        "name": "Security headers",
        "children": [
          {
            "name": "CSP",
            "children": [],
            "behaviors": [
              {
                "name": "modifyOutgoingResponseHeader",
                "options": {
                  "action": "ADD",
                  "customHeaderName": "Content-Security-Policy",
                  "customHeaderValue": "default-src 'self' *.rbcdemo.ca; frame-ancestors 'none'",
                  "standardModifyHeaderName": "OTHER"
                }
              }
            ],
            "criteria": [
              {
                "name": "fileExtension",
                "options": {
                  "matchOperator": "IS_ONE_OF",
                  "values": [
                    "html"
                  ],
                  "matchCaseSensitive": false
                }
              }
            ],
            "criteriaMustSatisfy": "all",
            "comment": ""
          }
        ],
        "behaviors": [
          {
            "name": "modifyOutgoingResponseHeader",
            "options": {
              "action": "ADD",
              "customHeaderName": "X-Content-Type-Options",
              "customHeaderValue": "nosniff",
              "standardModifyHeaderName": "OTHER"
            }
          }
        ],
        "criteria": [],
        "criteriaMustSatisfy": "all",
        "comment": ""
      },
      {
        "name": "Cache busting",
        "children": [],
        "behaviors": [
          {
            "name": "cacheKeyQueryParams",
            "options": {
              "behavior": "INCLUDE",
              "exactMatch": true,
              "parameters": [
                "v"
