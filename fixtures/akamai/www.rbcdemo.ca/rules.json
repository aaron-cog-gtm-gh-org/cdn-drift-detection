        "criteria": [
          {
            "name": "hostname",
            "options": {
              "matchOperator": "IS_ONE_OF",
              "values": [
                "promo.rbcdemo.ca"
              ],
              "matchCaseSensitive": false
            }
          }
        ],
        "criteriaMustSatisfy": "all",
        "comment": "ADDED out-of-band 2026-08-14 \u2014 not yet in TF golden (ticket EDG-2211)."
